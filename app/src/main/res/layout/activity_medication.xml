<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F4FF" android:id="@+id/main">

    <!-- Header -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/gradient_header" android:paddingTop="48dp" android:paddingBottom="20dp" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/sectionLayout1" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">

        <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle_blue" android:src="@drawable/ic_arrow_back" android:contentDescription="Quay lại" android:padding="10dp" android:alpha="0.85"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nhắc nhở thuốc" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thuốc và lịch uống theo chỉ định bác sĩ" android:textColor="#C7D9FF" android:textSize="12sp"/>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:src="@drawable/ic_add" android:contentDescription="Thêm thuốc" app:backgroundTint="#FFFFFF" app:tint="#0D6EFD" app:fabSize="mini"/>
    </LinearLayout>

    <!-- Today's progress banner -->
    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF" android:id="@+id/sectionLayout2" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/sectionLayout1">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="28sp"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đơn thuốc theo phiếu yêu cầu" android:textColor="#1A1A2E" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:id="@+id/txtTodayProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0/0 liều đã uống" android:textColor="#9CA3AF" android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/progressRing" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/bg_badge_green" android:gravity="center">
                <TextView android:id="@+id/txtPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#10B981" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tab row: Sáng / Trưa / Tối / Tất cả -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:background="@drawable/bg_card_modern" android:orientation="horizontal" android:padding="4dp" android:id="@+id/sectionLayout3" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/sectionLayout2">

        <TextView android:id="@+id/tabAll" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="Tất cả" android:textSize="13sp" android:textColor="#0D6EFD" android:background="@drawable/bg_icon_circle_blue" android:textStyle="bold"/>

        <TextView android:id="@+id/tabMorning" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="☀️ Sáng" android:textSize="13sp" android:textColor="#6B7280"/>

        <TextView android:id="@+id/tabNoon" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="🌤️ Trưa" android:textSize="13sp" android:textColor="#6B7280"/>

        <TextView android:id="@+id/tabEvening" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="🌙 Tối" android:textSize="13sp" android:textColor="#6B7280"/>
    </LinearLayout>

    <TextView android:id="@+id/txtEmpty" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Chưa có phiếu yêu cầu thanh toán. Vào Thanh toán để tạo phiếu trước." android:textColor="#9CA3AF" android:textSize="14sp" android:gravity="center" android:padding="24dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/sectionLayout3"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="0dp" android:layout_height="0dp" android:paddingTop="8dp" android:paddingBottom="16dp" android:clipToPadding="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/txtEmpty" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
