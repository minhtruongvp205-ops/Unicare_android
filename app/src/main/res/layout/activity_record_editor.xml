<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F0F4FF">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="32dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingHorizontal="12dp" android:paddingTop="42dp" android:paddingBottom="24dp"
                android:background="@drawable/gradient_header">
                <ImageButton android:id="@+id/btnBack" android:layout_width="44dp"
                    android:layout_height="44dp" android:padding="10dp"
                    android:contentDescription="Quay lại" android:src="@drawable/ic_arrow_back"
                    android:background="@drawable/bg_icon_circle_blue"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Phiếu khám tổng hợp" android:textSize="19sp"
                        android:textStyle="bold" android:textColor="#FFFFFF"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" android:text="Từ tiếp nhận đến hoàn tất lượt khám"
                        android:textSize="11sp" android:textColor="#C7D9FF"/>
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="01  THÔNG TIN BỆNH NHÂN" android:textColor="#0D6EFD"
                        android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtAppointment" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="9dp"
                        android:textColor="#1A1A2E" android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="02  CHỈ SỐ SỨC KHỎE" android:textColor="#0D6EFD"
                        android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtVisitVitals" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="9dp"
                        android:text="Chưa có chỉ số cho lượt khám này" android:textColor="#6B7280"
                        android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVisitVitals" style="@style/Widget.UniCare.Button"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:textAllCaps="false"
                        android:text="+ Nhập / xem chỉ số sức khỏe"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="03  KẾT QUẢ KHÁM BỆNH" android:textColor="#0D6EFD"
                        android:textStyle="bold" android:textSize="14sp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDiagnosis" style="@style/Widget.UniCare.TextInputLayout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:hint="Chẩn đoán">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtDiagnosis" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textMultiLine"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UniCare.TextInputLayout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:hint="Kết quả khám và dặn dò">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNotes" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textMultiLine"
                            android:minLines="2"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="04  KÊ ĐƠN THUỐC &amp; LỊCH UỐNG" android:textColor="#0D6EFD"
                        android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:id="@+id/txtCatalogDisclaimer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textColor="#6B7280"
                        android:textSize="12sp" android:visibility="gone"/>
                    <TextView android:id="@+id/txtOldPrescription"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textColor="#6B7280"
                        android:textSize="12sp" android:visibility="gone"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPrescription" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:nestedScrollingEnabled="false"
                        android:layout_marginTop="12dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddMedicine" style="@style/Widget.UniCare.Button"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textAllCaps="false"
                        android:text="+ Chọn nhiều thuốc từ danh mục"/>
                    <TextView android:id="@+id/txtPrescriptionTotal" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:text="Tổng tạm tính: 0 đ" android:textColor="#0D6EFD"
                        android:textStyle="bold" android:textSize="15sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textColor="#6B7280" android:textSize="11sp"
                        android:text="Không bắt buộc kê thuốc. Bác sĩ tự quyết định loại, liều lượng và thời điểm sử dụng."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveRecord" style="@style/Widget.UniCare.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="18dp"
                android:minHeight="55dp" android:text="Hoàn tất khám &amp; lưu hồ sơ"
                android:textAllCaps="false" android:textSize="16sp"/>
            <TextView android:id="@+id/txtMessage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp" android:gravity="center"
                android:textColor="#D32F2F" android:textSize="12sp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
