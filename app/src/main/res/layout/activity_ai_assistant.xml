<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aiDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/btnAiBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ai_arrow_back"
                android:contentDescription="Quay lại" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Hỏi - đáp\n(Chatbot)"
                android:textColor="#142D4F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EDF2F7" />

        <!-- Sidebar Trigger Button (Top-left below header as shown in Image 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/btnAiMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ai_menu"
                android:contentDescription="Mở lịch sử đoạn chat" />
        </LinearLayout>

        <!-- Main Scrollable Chat / Welcome Area -->
        <ScrollView
            android:id="@+id/aiScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/aiChatContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- Welcome Section (visible initially, hides when user chats) -->
                <LinearLayout
                    android:id="@+id/aiWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="28dp">

                    <TextView
                        android:id="@+id/tvWelcomeGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Xin chào, !"
                        android:textColor="#0E2A50"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWelcomeIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Tôi là trợ lý ảo y tế của UniCare, tôi có thể giúp bạn tra cứu lịch khám bệnh của Bác sĩ, hướng dẫn đặt khám, tư vấn khám chuyên khoa. Bạn có thể đặt câu hỏi để tôi hỗ trợ bạn."
                        android:textColor="#324F6C"
                        android:textSize="15.5sp"
                        android:lineSpacingExtra="5dp"
                        android:gravity="start" />

                    <!-- Quick suggestion buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/btnChipBooking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ai_quick_chip"
                            android:text="Hướng dẫn đặt khám"
                            android:textColor="#1A3B63"
                            android:textSize="14sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnChipIntro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ai_quick_chip"
                            android:text="Giới thiệu bệnh viện"
                            android:textColor="#1A3B63"
                            android:textSize="14sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Messages container for active chat -->
                <LinearLayout
                    android:id="@+id/aiMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Chat Input Panel (As shown in Image 2) -->
                <LinearLayout
                    android:id="@+id/aiInputPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_ai_input_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp">

                    <EditText
                        android:id="@+id/aiInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Vui lòng đặt câu hỏi......"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minHeight="44dp"
                        android:maxLines="4"
                        android:padding="0dp"
                        android:textColor="#163353"
                        android:textColorHint="#9DAFC1"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/aiMic"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="7dp"
                        android:src="@drawable/ic_ai_mic"
                        android:contentDescription="Giọng nói" />

                    <ImageView
                        android:id="@+id/aiSend"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_ai_send_circle"
                        android:contentDescription="Gửi câu hỏi"
                        android:padding="10dp"
                        android:src="@drawable/ic_ai_send_up" />
                </LinearLayout>

                <!-- Loading / Status text -->
                <TextView
                    android:id="@+id/aiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#607F98"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Bottom Disclaimer -->
                <TextView
                    android:id="@+id/tvDisclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:text="Nội dung được tạo bởi trí tuệ nhân tạo (AI), vui lòng xem như thông tin tham khảo, không thay thế cho tư vấn chuyên môn."
                    android:textColor="#65839F"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Navigation Drawer (Left Sidebar for chat history as shown in Image 1) -->
    <LinearLayout
        android:id="@+id/aiNavDrawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true">

        <!-- Top Header of Drawer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnAiMenuClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ai_menu"
                android:contentDescription="Đóng menu lịch sử" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EDF2F7" />

        <!-- List of history items (Từng đoạn chat) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/llChatHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <!-- Dynamically populated from AiChatHistoryManager -->

            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EDF2F7" />

        <!-- Bottom Actions (Cuộc trò chuyện mới & Tên tài khoản as shown in Image 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <!-- Cuộc trò chuyện mới Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewChat"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Cuộc trò chuyện mới"
                app:icon="@drawable/ic_ai_add"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:cornerRadius="10dp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#039BE5"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <!-- Account Name Bar (Dưới Trò chuyện mới) -->
            <LinearLayout
                android:id="@+id/layoutUserInfo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ai_user_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_ai_avatar" />

                <TextView
                    android:id="@+id/tvAccountName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Trương Công Minh"
                    android:textColor="#142D4F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ai_expand" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
