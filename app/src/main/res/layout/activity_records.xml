<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F4FF" android:id="@+id/main">

    <!-- Top AppBar -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/gradient_header" android:paddingTop="48dp" android:paddingBottom="20dp" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/sectionLayout1" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">

        <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle_blue" android:src="@drawable/ic_arrow_back" android:contentDescription="Quay lại" android:padding="10dp" android:alpha="0.85"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hồ sơ bệnh án" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kết quả khám và phác đồ điều trị" android:textColor="#C7D9FF" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state -->
    <TextView android:id="@+id/txtEmpty" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Đang tải dữ liệu..." android:textSize="15sp" android:textColor="#9CA3AF" android:gravity="center" android:padding="32dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/sectionLayout1"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="0dp" android:layout_height="0dp" android:paddingTop="8dp" android:paddingBottom="16dp" android:clipToPadding="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/txtEmpty" app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
